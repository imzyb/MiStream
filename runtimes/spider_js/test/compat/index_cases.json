    "rule": "a:eq(99)&&href",
    "expected": ""
  },
  {
    "name": ":eq 负数越界返回空",
    "method": "pdfh",
    "html": "<ul class=\"v\"><li><a href=\"/p/1\">第1集</a></li><li><a href=\"/p/2\">第2集</a></li></ul>",
    "rule": "a:eq(-99)&&href",
    "expected": ""
