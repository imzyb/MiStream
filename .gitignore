# Dart / Flutter
.dart_tool/
.packages
.pub/
.pub-cache/
build/
pubspec_overrides.yaml

# pub workspace 只在仓库根保留一份 lock（docs/10 §7）
**/pubspec.lock
!/pubspec.lock

# Flutter 生成物
.flutter-plugins
.flutter-plugins-dependencies
**/generated_plugin_registrant.dart
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh
**/ephemeral/

# 运行时产物
logs/
coverage/
*.log

# 编辑器
.idea/
.vscode/
*.iml
*.iws

# 生成代码（ADR-008：drift 产物不提交，CI 走 build_runner）
**/*.g.dart
# 例外（2026-10-02）：`melos run generate` 在 CI 里写 **0 个输出** —— pub workspace
# 下 build_runner 2.15.1 不再把「当前包」当 root package（本地同样复现不了：
# `dart run build_runner` 要先起 frontend_server 子进程，撞本机命名管道缺陷）。
# 于是干净检出里没有 drift 产物，`flutter analyze` 报 613 个「生成符号未定义」，
# Release 的「门禁」直接挂、后续构建全部 skipped —— 发布链一个包都产不出。
# 先把这**唯一**一个生成产物入库解封；治本方向见 pubspec.yaml 的 generate 脚本。
!packages/storage/lib/src/database/database.g.dart

# QuickJS native 产物（runtimes/spider_js/native/build.bat 本地构建，不入库）。
# 源码与构建脚本在 native/ 下受版本管理；二进制不进仓库，理由见 docs/10 §10
# 与 ROADMAP 风险 R5（体积预算）。
runtimes/spider_js/**/*.dll
runtimes/spider_js/**/*.obj
runtimes/spider_js/**/*.lib
runtimes/spider_js/**/*.exp

# 系统
.DS_Store
Thumbs.db

# AI 助手工作区（含记忆与项目数据，属本地环境，不入库）
.workbuddy-ai/

# Flutter 工具链临时状态
**/.flutter_tool_state
